# frozen_string_literal: true

# SB-2140 Stage 1 — commit-ordered sequence ("commit_seq").
#
# ## Why
#
# `sequence` (BIGSERIAL via nextval) is assigned at INSERT, inside the producer
# transaction, but rows only become visible at COMMIT. Under concurrency,
# assignment order != commit order, so a lower-`sequence` row that commits AFTER
# a higher one on the same partition lands BELOW the consumer's high-water offset
# and is silently never delivered.
#
# ## What this migration installs
#
# * outbox_relay_partition_seq — a transactional per-(topic, partition) sequencer.
# * outbox_relay_outbox_events.commit_seq — the new ordering token (nullable here;
#   set NOT NULL in a later hardening migration once backfilled + verified).
# * A DEFERRABLE INITIALLY DEFERRED, statement-level, AFTER INSERT constraint
#   trigger that assigns commit_seq at the COMMIT edge. The per-partition
#   sequencer row lock (released only at commit) forces, per (topic, partition):
#       commit_seq order == commit order == visibility order
#   so a consumer reading `WHERE commit_seq > offset ORDER BY commit_seq` can
#   never skip a row. The DEFERRED edge means a long bulk-import transaction holds
#   the sequencer lock for milliseconds at the very end, not for the whole import.
#
# Consumers still read by `sequence` after this migration — flipping them to
# `commit_seq` is a separate gem release.
#
# ## Caveats
#
# * Triggers do NOT fire when `session_replication_role = 'replica'` (logical
#   replication / DMS / blue-green apply). For an app-written outbox this is fine;
#   any non-app insert path would leave commit_seq NULL.
# * A bug in the trigger fails publishes at COMMIT (fail-closed; at-least-once
#   preserved). Verify on staging before production.
#
# Run with: rails generate outbox_relay:add_commit_seq
class AddCommitSeqToOutboxRelayOutboxEvents < ActiveRecord::Migration<%= migration_version %>
  disable_ddl_transaction!

  BACKFILL_BATCH_SIZE = 10_000

  def up
    create_partition_seq_table
    add_column :outbox_relay_outbox_events, :commit_seq, :bigint unless column_exists?(:outbox_relay_outbox_events, :commit_seq)

    # Seed existing partitions and install the trigger atomically under a brief
    # write-blocking lock (reads are unaffected). This guarantees no INSERT can
    # slip through between seeding and trigger creation: every post-lock insert
    # sees the trigger AND a seeded sequencer. The lock is held only for fast DDL
    # — the heavy backfill of historical rows runs afterwards, unlocked.
    transaction do
      execute "LOCK TABLE outbox_relay_outbox_events IN SHARE ROW EXCLUSIVE MODE"
      seed_existing_partitions
      execute create_function_sql
      execute create_trigger_sql
    end

    backfill_historical_rows
    add_commit_seq_index
  end

  def down
    execute "DROP TRIGGER IF EXISTS outbox_relay_commit_seq_trg ON outbox_relay_outbox_events"
    execute "DROP FUNCTION IF EXISTS outbox_relay_assign_commit_seq()"
    remove_index :outbox_relay_outbox_events, name: "idx_outbox_commit_seq_fetch", if_exists: true
    remove_column :outbox_relay_outbox_events, :commit_seq, if_exists: true
    drop_table :outbox_relay_partition_seq, if_exists: true
  end

  private

  def create_partition_seq_table
    return if table_exists?(:outbox_relay_partition_seq)

    create_table :outbox_relay_partition_seq, id: false do |t|
      t.string  :topic,        null: false
      t.integer :partition_id, null: false
      t.bigint  :next_seq,     null: false, default: 0
    end
    execute <<~SQL
      ALTER TABLE outbox_relay_partition_seq
        ADD CONSTRAINT outbox_relay_partition_seq_pkey PRIMARY KEY (topic, partition_id)
    SQL
  end

  # Seed every existing (topic, partition_key) sequencer row from the GLOBAL
  # sequence high-water — NOT the per-partition max. Offsets are global `sequence`
  # values; seeding from the global max guarantees every post-cutover commit_seq
  # exceeds every existing consumer offset, so the consumer flip needs no
  # offset-row migration. ON CONFLICT DO NOTHING keeps re-runs idempotent.
  def seed_existing_partitions
    execute <<~SQL
      INSERT INTO outbox_relay_partition_seq (topic, partition_id, next_seq)
      SELECT d.topic, d.partition_key,
             (SELECT last_value FROM outbox_relay_outbox_events_sequence)
      FROM (SELECT DISTINCT topic, partition_key FROM outbox_relay_outbox_events) d
      ON CONFLICT (topic, partition_id) DO NOTHING
    SQL
  end

  # Historical rows: commit_seq = sequence. The global sequence ascends, so this
  # is per-partition monotonic and globally unique → satisfies the partial unique
  # index. Only touches still-NULL rows (post-trigger inserts already have a
  # commit_seq), so it never races the live trigger. Batched to bound lock time.
  def backfill_historical_rows
    loop do
      affected = exec_update(<<~SQL)
        UPDATE outbox_relay_outbox_events
           SET commit_seq = sequence
         WHERE id IN (
           SELECT id FROM outbox_relay_outbox_events
            WHERE commit_seq IS NULL
            LIMIT #{BACKFILL_BATCH_SIZE}
         )
      SQL
      break if affected.zero?
    end
  end

  def add_commit_seq_index
    return if index_exists?(:outbox_relay_outbox_events, %i[topic partition_key commit_seq],
                            name: "idx_outbox_commit_seq_fetch")

    # Partial (commit_seq IS NOT NULL) so NULLs during/after backfill are allowed
    # and so it stays valid before the NOT NULL hardening migration. Serves the
    # consumer fetch `WHERE topic=? AND partition_key=? AND commit_seq > ? ORDER BY commit_seq`
    # and proves no per-partition duplicates.
    add_index :outbox_relay_outbox_events, %i[topic partition_key commit_seq],
              unique: true,
              where: "commit_seq IS NOT NULL",
              name: "idx_outbox_commit_seq_fetch",
              algorithm: :concurrently
  end

  def create_function_sql
    <<~SQL
      CREATE OR REPLACE FUNCTION outbox_relay_assign_commit_seq()
      RETURNS trigger LANGUAGE plpgsql AS $fn$
      DECLARE
        part RECORD;
        base bigint;
      BEGIN
        -- `inserted` is the per-statement transition table: EXACTLY the rows this
        -- statement inserted in THIS transaction. No global "commit_seq IS NULL"
        -- scan, so it cannot relabel another transaction's rows.
        FOR part IN
          SELECT topic, partition_key, count(*) AS n
          FROM inserted
          GROUP BY topic, partition_key
          ORDER BY topic COLLATE "C", partition_key   -- canonical, collation-stable lock order (deadlock-free)
        LOOP
          -- Lock-or-create the sequencer row. UPDATE first (the steady-state hot
          -- path); on a brand-new (topic, partition) seed it from the GLOBAL
          -- sequence high-water, which always exceeds every existing commit_seq,
          -- so a never-seen partition's first event still lands above any offset.
          LOOP
            UPDATE outbox_relay_partition_seq
               SET next_seq = next_seq + part.n
             WHERE topic = part.topic AND partition_id = part.partition_key
             RETURNING next_seq INTO base;
            EXIT WHEN FOUND;
            BEGIN
              INSERT INTO outbox_relay_partition_seq (topic, partition_id, next_seq)
              VALUES (part.topic, part.partition_key,
                      (SELECT last_value FROM outbox_relay_outbox_events_sequence) + part.n)
              RETURNING next_seq INTO base;
              EXIT;
            EXCEPTION WHEN unique_violation THEN
              -- A concurrent transaction created the row first; retry the UPDATE.
            END;
          END LOOP;

          -- Assign commit_seq to this statement's rows for the partition, in
          -- insertion order (sequence). base is the new high-water (old + n), so
          -- the block is [base - n + 1 .. base].
          WITH ordered AS (
            SELECT i.id, row_number() OVER (ORDER BY i.sequence) AS rn
            FROM inserted i
            WHERE i.topic = part.topic AND i.partition_key = part.partition_key
          )
          UPDATE outbox_relay_outbox_events e
             SET commit_seq = base - part.n + ordered.rn
            FROM ordered
           WHERE e.id = ordered.id;
        END LOOP;

        RETURN NULL;
      END;
      $fn$;
    SQL
  end

  def create_trigger_sql
    <<~SQL
      CREATE CONSTRAINT TRIGGER outbox_relay_commit_seq_trg
        AFTER INSERT ON outbox_relay_outbox_events
        DEFERRABLE INITIALLY DEFERRED
        REFERENCING NEW TABLE AS inserted
        FOR EACH STATEMENT
        EXECUTE FUNCTION outbox_relay_assign_commit_seq();
    SQL
  end
end
