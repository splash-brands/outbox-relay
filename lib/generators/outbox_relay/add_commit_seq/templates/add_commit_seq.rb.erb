  private

  def create_partition_seq_table
    return if table_exists?(:outbox_relay_partition_seq)

    create_table :outbox_relay_partition_seq, id: false do |t|
      t.string  :topic,        null: false
      t.integer :partition_id, null: false
      t.bigint  :next_seq,     null: false, default: 0
    end
