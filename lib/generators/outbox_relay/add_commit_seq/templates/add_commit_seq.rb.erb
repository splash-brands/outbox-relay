      CREATE OR REPLACE FUNCTION outbox_relay_assign_commit_seq()
      RETURNS trigger LANGUAGE plpgsql AS $fn$
      DECLARE
        base bigint;
      BEGIN
        -- Defensive: never overwrite an explicitly-set value (Ruby never sets it;
        -- the backfill uses UPDATE, which does not fire this INSERT trigger).
        IF NEW.commit_seq IS NOT NULL THEN
          RETURN NULL;
        END IF;

        -- Serialize commit-edge assignment per topic so that, per (topic,
        -- partition): commit_seq order == commit order == visibility order.
        -- Two-int advisory form is a distinct lock space from the consumer's
        -- bigint advisory locks, so they never collide. Per-topic (not
        -- per-partition) makes multi-partition transactions deadlock-free.
        PERFORM pg_advisory_xact_lock(hashtext('outbox_relay_commit_seq'), hashtext(NEW.topic));

        -- Lock-or-create this partition's sequencer row. A brand-new partition is
        -- seeded from the GLOBAL sequence high-water, which exceeds every existing
        -- commit_seq, so its first event still lands above any consumer offset.
        LOOP
          UPDATE outbox_relay_partition_seq
             SET next_seq = next_seq + 1
           WHERE topic = NEW.topic AND partition_id = NEW.partition_key
           RETURNING next_seq INTO base;
          EXIT WHEN FOUND;
          BEGIN
            INSERT INTO outbox_relay_partition_seq (topic, partition_id, next_seq)
            VALUES (NEW.topic, NEW.partition_key,
                    (SELECT last_value FROM outbox_relay_outbox_events_sequence) + 1)
            RETURNING next_seq INTO base;
            EXIT;
          EXCEPTION WHEN unique_violation THEN
            -- A concurrent transaction created the row first; retry the UPDATE.
          END;
        END LOOP;

        UPDATE outbox_relay_outbox_events SET commit_seq = base WHERE id = NEW.id;
        RETURN NULL;
      END;
      $fn$;
    SQL
  end

  def create_trigger_sql
    <<~SQL
      CREATE CONSTRAINT TRIGGER outbox_relay_commit_seq_trg
        AFTER INSERT ON outbox_relay_outbox_events
        DEFERRABLE INITIALLY DEFERRED
        FOR EACH ROW
        EXECUTE FUNCTION outbox_relay_assign_commit_seq();
    SQL
  end
end
