#!/usr/bin/env ruby
# frozen_string_literal: true

# This file is auto-generated by OutboxRelay. Do not edit manually.

# macOS fork-safety setup
# Required to prevent crashes when forking processes on macOS
if RUBY_PLATFORM.include?("darwin")
  unless ENV["OBJC_DISABLE_INITIALIZE_FORK_SAFETY"] == "YES" && ENV["PGGSSENCMODE"] == "disable"
    ENV["OBJC_DISABLE_INITIALIZE_FORK_SAFETY"] = "YES"
    ENV["PGGSSENCMODE"] = "disable"
    exec(ENV, $PROGRAM_NAME, *ARGV)
  end
end

# Load Rails application
require_relative "../config/environment"

# Load OutboxRelay CLI
require "outbox_relay/cli"

# Start the CLI with provided arguments
OutboxRelay::CLI.start(ARGV)
