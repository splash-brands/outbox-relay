# frozen_string_literal: true

# SB-2140 Stage 3 — fail-loud hardening for commit_seq.
#
# Installs a second DEFERRABLE INITIALLY DEFERRED, per-ROW constraint trigger that
# runs AFTER the assignment trigger (its name sorts later, so it fires later among
# the same row's deferred triggers) and raises at COMMIT if the row still has a
# NULL commit_seq. That only happens if the assignment trigger
# (outbox_relay_commit_seq_trg) was dropped/disabled — in which case we want a
# loud, fail-closed error rather than silently un-fetchable NULL rows.
#
# Per-row (not statement-level with a transition table): a CONSTRAINT TRIGGER must
# be FOR EACH ROW and may not use REFERENCING ... TABLE. The trigger re-reads the
# row (NEW still holds the INSERT-time image, where commit_seq was NULL) to see the
# value the assignment trigger wrote earlier in the same commit.
#
# Deploy ONLY after add_commit_seq is verified in production (zero committed NULL
# commit_seq rows).
#
# Run with: rails generate outbox_relay:harden_commit_seq
class HardenCommitSeqOnOutboxRelayOutboxEvents < ActiveRecord::Migration<%= migration_version %>
  def up
    safety_assured do
      execute <<~SQL
        CREATE OR REPLACE FUNCTION outbox_relay_assert_commit_seq()
        RETURNS trigger LANGUAGE plpgsql AS $fn$
        BEGIN
          -- Re-read the current row image (NEW is the INSERT-time snapshot, where
          -- commit_seq was still NULL); the assignment trigger has already run.
          IF (SELECT commit_seq FROM outbox_relay_outbox_events WHERE id = NEW.id) IS NULL THEN
            RAISE EXCEPTION
              'outbox_relay: commit_seq unassigned for id=% — assignment trigger missing or disabled (SB-2140)',
              NEW.id;
          END IF;
          RETURN NULL;
        END;
        $fn$;
      SQL

      # Name sorts after outbox_relay_commit_seq_trg so it fires after assignment.
      execute <<~SQL
        CREATE CONSTRAINT TRIGGER outbox_relay_commit_seq_verify_trg
          AFTER INSERT ON outbox_relay_outbox_events
          DEFERRABLE INITIALLY DEFERRED
          FOR EACH ROW
          EXECUTE FUNCTION outbox_relay_assert_commit_seq();
      SQL
    end
  end

  def down
    safety_assured do
      execute "DROP TRIGGER IF EXISTS outbox_relay_commit_seq_verify_trg ON outbox_relay_outbox_events"
      execute "DROP FUNCTION IF EXISTS outbox_relay_assert_commit_seq()"
    end
  end
end
